# =================================================================
# SecondLife Environment Configuration
# =================================================================

# Server
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication Secrets
JWT_SECRET=secondlife-super-secure-production-jwt-secret-key-32-chars-min
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=secondlife-refresh-token-secret-production-random-key
REFRESH_TOKEN_EXPIRES_IN=30d

# Database Configuration
# Supported drivers: 'sqlite' (zero-dependency local file), 'postgres' (production PostgreSQL)
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/secondlife.db

# PostgreSQL (when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=secondlife_user
DB_PASSWORD=secondlife_password
DB_NAME=secondlife_db
DB_SSL=false

# Redis Cache (Optional, in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Payment Provider Configuration
# Supported providers: 'sandbox' (Built-in mock simulator with complete lifecycle), 'stripe'
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key_here

# Python AI & Recommendation Microservice
PYTHON_RECOMMENDATION_SERVICE_URL=http://localhost:8000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=debug
