{
  "name": "secondlife-backend",
  "version": "1.0.0",
  "description": "SecondLife E-Commerce Platform REST API & Business Logic Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
